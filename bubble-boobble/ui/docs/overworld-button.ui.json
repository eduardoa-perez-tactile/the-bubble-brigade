{
  "$schemaVersion": 1,
  "guid": "268a9b4c-36e8-4dc0-bfe4-442f36ad89a7",
  "name": "overworld-button",
  "title": "Overworld button",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld button",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "w": 280,
        "h": 48,
        "justify": "center"
      },
      "children": [
        "owb_label"
      ]
    },
    "owb_label": {
      "type": "label",
      "name": "Label",
      "text": "{label}",
      "style": {
        "w": "96%",
        "h": 36,
        "fontSize": 23,
        "fitMin": 18,
        "color": "#30271e",
        "textAlign": "center"
      }
    }
  },
  "behaviour": "button",
  "properties": {
    "label": {
      "type": "text",
      "default": "CONTINUE"
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#00000000"
            },
            "owb_label": {
              "color": "#a6472d",
              "tx": 5
            }
          }
        }
      }
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "bg": "#c6984b"
        }
      }
    },
    "disabled": {
      "set": {
        "root": {
          "bg": "#b8a989",
          "opacity": 0.6
        }
      }
    }
  }
}
