{
  "$schemaVersion": 1,
  "guid": "268a9b4c-36e8-4dc0-bfe4-442f36ad89a7",
  "name": "overworld-button",
  "title": "Overworld button",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld button",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#e8d5ad",
        "radius": 9,
        "w": 280,
        "h": 48,
        "justify": "center"
      },
      "children": [
        "owb_label"
      ]
    },
    "owb_label": {
      "type": "label",
      "name": "Label",
      "text": "{label}",
      "style": {
        "w": "96%",
        "h": 36,
        "fontSize": 22,
        "fitMin": 18,
        "color": "#254d4b",
        "textAlign": "center"
      }
    }
  },
  "behaviour": "button",
  "properties": {
    "label": {
      "type": "text",
      "default": "CONTINUE"
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#245c5b"
            },
            "owb_label": {
              "color": "#fff0ca",
              "tx": 0
            }
          }
        }
      }
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "bg": "#b9863d",
          "scale": 0.97,
          "ty": 2
        },
        "owb_label": {
          "color": "#fff3d2"
        }
      },
      "transition": {
        "type": "easeOut",
        "ms": 90
      }
    },
    "disabled": {
      "set": {
        "root": {
          "bg": "#b8a989",
          "opacity": 0.6
        }
      }
    }
  },
  "transition": {
    "type": "easeOut",
    "ms": 160
  }
}
