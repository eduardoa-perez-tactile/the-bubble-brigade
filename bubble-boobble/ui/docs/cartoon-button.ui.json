{
  "$schemaVersion": 1,
  "guid": "7cbbb22d-6829-4350-aa65-ea48499c9cb1",
  "name": "cartoon-button",
  "title": "Cartoon button",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Cartoon button",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "w": 332,
        "h": 44,
        "justify": "center"
      },
      "children": [
        "cb_label",
        "cb_pointer",
        "cb_art"
      ]
    },
    "cb_label": {
      "type": "label",
      "name": "Label",
      "text": "{label}",
      "style": {
        "fontSize": 48,
        "weight": 800,
        "color": "#f3e3be",
        "w": "100%",
        "h": 64,
        "textAlign": "left",
        "fitMin": 24,
        "attach": true
      }
    },
    "cb_pointer": {
      "type": "element",
      "name": "Element",
      "children": [
        "cb_pointer_ink"
      ],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0,
          0.5
        ],
        "offset": [
          -96,
          0
        ],
        "w": 84,
        "h": 66,
        "attach": true
      },
      "show": "selected"
    },
    "cb_pointer_ink": {
      "type": "icon",
      "image": "cartoon/menu/focus-bubble",
      "style": {
        "w": 84,
        "h": 66,
        "fit": "contain"
      }
    },
    "cb_art": {
      "type": "icon",
      "property": "art",
      "image": "cartoon/menu/focus-bubble",
      "style": {
        "position": "anchored",
        "anchor": [
          0,
          0.5
        ],
        "pivot": [
          0,
          0.5
        ],
        "offset": [
          0,
          0
        ],
        "w": "100%",
        "h": "100%",
        "fit": "contain",
        "hide": true,
        "tintMode": "multiply"
      }
    }
  },
  "behaviour": "button",
  "transition": {
    "type": "easeOut",
    "ms": 90
  },
  "properties": {
    "label": {
      "type": "text",
      "default": "START GAME"
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#00000000"
            },
            "cb_label": {
              "color": "#f4d79a",
              "tx": 4
            },
            "cb_art": {
              "tint": "#f4d79a"
            }
          }
        }
      }
    },
    "art": {
      "type": "image",
      "default": "cartoon/menu/focus-bubble"
    },
    "hasArt": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "cb_label": {
              "opacity": 0.001
            },
            "cb_art": {
              "hide": false
            }
          }
        }
      }
    },
    "compact": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "cb_pointer": {
              "scale": 0.76,
              "tx": 32
            }
          }
        }
      }
    },
    "showPointer": {
      "type": "yesno",
      "default": true,
      "poses": {
        "no": {
          "set": {
            "cb_pointer": {
              "hide": true
            }
          }
        }
      }
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "scale": 1
        },
        "cb_label": {
          "scale": 0.96,
          "color": "#a6472d"
        },
        "cb_art": {
          "scale": 0.96,
          "opacity": 0.8
        }
      }
    },
    "disabled": {
      "set": {
        "root": {
          "opacity": 0.38
        },
        "cb_pointer": {
          "hide": true
        }
      }
    }
  }
}
