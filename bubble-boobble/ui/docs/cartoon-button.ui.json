{
  "$schemaVersion": 1,
  "guid": "7cbbb22d-6829-4350-aa65-ea48499c9cb1",
  "name": "cartoon-button",
  "title": "Cartoon button",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Cartoon button",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "w": 332,
        "h": 44,
        "justify": "center"
      },
      "children": [
        "cb_label",
        "cb_pointer"
      ]
    },
    "cb_label": {
      "type": "label",
      "name": "Label",
      "text": "{label}",
      "style": {
        "fontSize": 32,
        "weight": 800,
        "color": "#30271e",
        "w": 300,
        "h": 46,
        "textAlign": "center",
        "fitMin": 12
      }
    },
    "cb_pointer": {
      "type": "element",
      "name": "Element",
      "children": [
        "cb_pointer_ink"
      ],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0,
          0.5
        ],
        "offset": [
          18,
          0
        ],
        "w": 24,
        "h": 44
      },
      "show": "selected"
    },
    "cb_pointer_ink": {
      "type": "label",
      "name": "Label",
      "text": ">",
      "style": {
        "w": 24,
        "h": 44,
        "fontSize": 28,
        "weight": 800,
        "color": "#a6472d",
        "textAlign": "center"
      }
    }
  },
  "behaviour": "button",
  "transition": {
    "type": "easeOut",
    "ms": 90
  },
  "properties": {
    "label": {
      "type": "text",
      "default": "START GAME"
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#00000000"
            },
            "cb_label": {
              "color": "#a6472d",
              "tx": 4
            }
          }
        }
      }
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "scale": 1
        },
        "cb_label": {
          "scale": 0.96,
          "color": "#a6472d"
        }
      }
    },
    "disabled": {
      "set": {
        "root": {
          "opacity": 0.38
        },
        "cb_pointer": {
          "hide": true
        }
      }
    }
  }
}
