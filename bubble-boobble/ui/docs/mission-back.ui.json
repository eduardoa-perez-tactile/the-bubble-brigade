{
  "$schemaVersion": 1,
  "guid": "00167975-a861-47cd-a51a-b9023914e880",
  "name": "mission-back",
  "title": "Mission back action",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Mission back",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "radius": 7,
        "justify": "start",
        "gap": 12,
        "w": "100%",
        "h": 60
      },
      "children": [
        "mb_arrow",
        "mb_label"
      ]
    },
    "mb_label": {
      "type": "label",
      "name": "Label",
      "text": "{label}",
      "style": {
        "w": "auto",
        "grow": 0,
        "h": 48,
        "fontSize": 22,
        "fitMin": 20,
        "color": "#124b4e",
        "textAlign": "left"
      }
    },
    "mb_arrow": {
      "type": "icon",
      "name": "Icon",
      "image": "adventure/briefing/back-arrow",
      "style": {
        "size": 32,
        "w": 14,
        "h": 24
      }
    }
  },
  "behaviour": "button",
  "transition": {
    "type": "easeOut",
    "ms": 120
  },
  "properties": {
    "label": {
      "type": "text",
      "default": "Back to map"
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#dfebdc"
            }
          }
        }
      }
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "scale": 0.985,
          "ty": 1,
          "bg": "#b9863d"
        }
      },
      "transition": {
        "type": "easeOut",
        "ms": 90
      }
    },
    "disabled": {
      "set": {
        "root": {
          "opacity": 0.6
        }
      }
    }
  }
}
