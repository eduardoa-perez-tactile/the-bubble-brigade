  "view": {
    "behaviour": "screen",
    "safe": true,
    "enter": {
      "set": {
        "content": {
          "opacity": 0,
          "ty": 10
        },
        "merchant": {
          "rotate": -5,
          "ty": 24,
          "scale": 0.94
        }
      }
    },
    "exit": {
      "set": {
        "content": {
          "opacity": 0
        },
        "merchant": {
          "rotate": -6,
          "ty": 16,
          "scale": 0.96
        }
      },
      "transition": {
        "type": "easeOut",
        "ms": 180
      }
    }
  },
