  "reactions": {
    "merchantNod": {
      "on": {
        "property": "merchantNod",
        "change": "trigger"
      },
      "set": {
        "merchant": {
          "rotate": 4,
          "ty": 7,
          "scale": 1.02
        }
      },
      "in": {
        "type": "easeOut",
        "ms": 100
      },
      "hold": 70,
      "back": {
        "type": "easeOut",
        "ms": 190
      }
    }
