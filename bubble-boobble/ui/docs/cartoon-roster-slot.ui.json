  "properties": {
    "name": {
      "type": "text",
      "default": ""
    },
    "status": {
      "type": "text",
      "default": ""
    },
    "active": {
      "type": "yesno",
      "default": true,
      "poses": {
        "no": {
          "set": {
            "root": {
              "opacity": 0.45
            }
          }
        }
      }
    },
    "down": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "cr_status": {
              "color": "#a13e26"
            },
            "root": {
              "bg": "#00000000"
            }
          }
        }
      }
    },
    "number": {
      "type": "text",
      "default": "1"
    },
    "condition": {
      "type": "enum",
      "values": [
        "ready",
        "rescue",
        "returning",
        "out",
        "open"
      ],
      "default": "ready",
      "poses": {
        "rescue": {
          "set": {
            "cr_status": {
              "color": "#a6472d"
            },
            "rescue_mark": {
              "hide": false
            }
          }
        },
        "out": {
          "set": {
            "cr_status": {
              "color": "#746047"
            },
            "root": {
              "opacity": 0.45
            }
          }
        },
        "open": {
          "set": {
            "root": {
              "opacity": 0.35
            }
          }
        }
      }
    }
