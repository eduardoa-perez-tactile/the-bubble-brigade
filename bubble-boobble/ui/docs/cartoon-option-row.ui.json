{
  "$schemaVersion": 1,
  "guid": "5bc17164-9ea3-4c65-a133-ef0c6603dc41",
  "name": "cartoon-option-row",
  "title": "Cartoon option row",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Cartoon option row",
      "style": {
        "dir": "row",
        "pad": 10,
        "align": "center",
        "radius": 9,
        "w": "100%",
        "h": 48,
        "gap": 8,
        "bg": "#e8d5ad",
        "justify": "space-between"
      },
      "children": [
        "op_label",
        "op_left",
        "op_value",
        "op_right"
      ]
    },
    "op_label": {
      "type": "label",
      "name": "Label",
      "text": "Label",
      "property": "label",
      "style": {
        "w": "48%",
        "h": 30,
        "fontSize": 20,
        "fitMin": 14,
        "color": "#254d4b"
      }
    },
    "op_value": {
      "type": "label",
      "name": "Label",
      "text": "Value",
      "property": "value",
      "style": {
        "w": "34%",
        "h": 30,
        "textAlign": "center",
        "fontSize": 20,
        "fitMin": 14,
        "color": "#254d4b"
      }
    },
    "op_left": {
      "type": "label",
      "name": "Label",
      "text": "<",
      "style": {
        "w": 18,
        "h": 30,
        "fontSize": 20,
        "color": "#254d4b"
      },
      "show": "adjustable"
    },
    "op_right": {
      "type": "label",
      "name": "Label",
      "text": ">",
      "style": {
        "w": 18,
        "h": 30,
        "fontSize": 20,
        "color": "#254d4b"
      },
      "show": "adjustable"
    }
  },
  "behaviour": "button",
  "transition": {
    "type": "easeOut",
    "ms": 160
  },
  "properties": {
    "label": {
      "type": "text",
      "default": ""
    },
    "value": {
      "type": "text",
      "default": ""
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "op_label": {
              "color": "#fff0ca"
            },
            "op_value": {
              "color": "#fff0ca"
            },
            "root": {
              "bg": "#245c5b"
            },
            "op_left": {
              "color": "#fff0ca"
            },
            "op_right": {
              "color": "#fff0ca"
            }
          }
        }
      }
    },
    "adjustable": {
      "type": "yesno",
      "default": false
    }
  },
  "states": {
    "pressed": {
      "set": {
        "root": {
          "tx": 0,
          "bg": "#b9863d",
          "scale": 0.97,
          "ty": 2
        }
      },
      "transition": {
        "type": "easeOut",
        "ms": 90
      }
    },
    "disabled": {
      "set": {
        "root": {
          "opacity": 0.6,
          "bg": "#b8a989"
        }
      }
    }
  }
}
