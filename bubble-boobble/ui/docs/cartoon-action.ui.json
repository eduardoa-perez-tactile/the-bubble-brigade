      "property": "label"
    },
    "d_button_marker": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0,
          0
        ],
        "offset": [
          -5,
          0
        ],
        "w": 2,
        "h": "100%",
        "bg": "#c68b39",
        "attach": true
      },
      "show": "selected"
    }
  },
  "transition": {
    "type": "instant"
  },
  "behaviour": "button",
  "properties": {
    "label": {
      "type": "text",
      "default": "BACK"
    },
    "selected": {
      "type": "yesno",
      "default": false,
