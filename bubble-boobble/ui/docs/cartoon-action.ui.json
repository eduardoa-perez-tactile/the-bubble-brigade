    "db_label": {
      "type": "label",
      "name": "Label",
      "text": "Label",
      "style": {
        "fontSize": 18,
        "color": "#30271e",
        "textAlign": "center",
        "outline": 0,
        "w": "90%",
        "h": 28,
        "fitMin": 10
