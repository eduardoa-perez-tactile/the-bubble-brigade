{
  "$schemaVersion": 1,
  "guid": "c96c8437-9429-4690-bc19-65bf35ff171b",
  "name": "cartoon-action",
  "title": "Cartoon Action",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Cartoon action",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "w": 440,
        "h": 38,
        "justify": "center"
      },
      "children": [
        "db_label",
        "d_button_marker"
      ]
