{
  "$schemaVersion": 1,
  "guid": "f59df77c-fd1d-4be1-a7dc-829353dcb389",
  "name": "cartoon-key-button",
  "title": "Cartoon Key Button",
  "kind": "widget",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Cartoon key button",
      "style": {
        "dir": "row",
        "pad": 0,
        "align": "center",
        "bg": "#00000000",
        "radius": 0,
        "w": 48,
        "h": 38,
        "justify": "center"
      },
      "children": [
        "dkb_label",
        "d_key_button_marker"
      ]
    },
    "dkb_label": {
      "type": "label",
      "name": "Label",
      "text": "Label",
      "style": {
        "fontSize": 14,
        "color": "#30271e",
        "outline": 0
      },
      "property": "label"
    },
    "d_key_button_marker": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0,
          0
        ],
        "offset": [
          -5,
          0
        ],
        "w": 2,
        "h": "100%",
        "bg": "#c68b39",
        "attach": true
      },
      "show": "selected"
    }
  },
  "transition": {
    "type": "instant"
  },
  "behaviour": "button",
  "properties": {
    "label": {
      "type": "text",
      "default": ""
    },
    "selected": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "root": {
              "bg": "#30271e"
            },
            "dkb_label": {
              "color": "#f1e3bf",
              "outline": 0
            }
          }
        }
      }
    }
  }
}
