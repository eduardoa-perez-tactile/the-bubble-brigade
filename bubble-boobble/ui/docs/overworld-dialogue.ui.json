{
  "$schemaVersion": 1,
  "guid": "2dff39bd-f839-43bf-932e-5a1412ffe393",
  "name": "overworld-dialogue",
  "title": "Overworld dialogue",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld dialogue",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 24,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ow_panel"
      ]
    },
    "ow_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "ow_rule",
        "owd_speaker",
        "owd_message",
        "owd_detail",
        "owd_buttons",
        "owd_back"
      ],
      "style": {
        "pad": 20,
        "dir": "column",
        "align": "center",
        "gap": 8,
        "w": 520,
        "h": "auto",
        "bg": "#eee0bc",
        "radius": 8
      }
    },
    "ow_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#8c5a35"
      }
    },
    "owd_speaker": {
      "type": "label",
      "name": "Label",
      "text": "{speaker}",
      "style": {
        "fontSize": 30,
        "fitMin": 13,
        "w": "100%",
        "h": 42,
        "color": "#382d25",
        "textAlign": "center"
      }
    },
    "owd_message": {
      "type": "label",
      "name": "Label",
      "text": "{message}",
      "style": {
        "fontSize": 21,
        "fitMin": 13,
        "w": "100%",
        "h": 160,
        "color": "#5a4936",
        "textAlign": "center"
      }
    },
    "owd_detail": {
      "type": "label",
      "name": "Label",
      "text": "{detail}",
      "style": {
        "fontSize": 17,
        "fitMin": 13,
        "w": "100%",
        "h": 42,
        "color": "#88603b",
        "textAlign": "center"
      }
    },
    "owd_buttons": {
      "type": "repeat",
      "doc": "overworld-button",
      "property": "buttons",
      "style": {
        "gap": 6,
        "w": "100%"
      }
    },
    "owd_back": {
      "type": "use",
      "doc": "overworld-button",
      "key": "back",
      "props": {
        "label": "BACK"
      },
      "style": {
        "w": "100%"
      },
      "show": "showBack"
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true
  },
  "properties": {
    "speaker": {
      "type": "text",
      "default": ""
    },
    "message": {
      "type": "text",
      "default": ""
    },
    "detail": {
      "type": "text",
      "default": ""
    },
    "buttons": {
      "type": "list",
      "of": "overworld-button",
      "default": []
    },
    "showBack": {
      "type": "yesno",
      "default": true
    }
  }
}
