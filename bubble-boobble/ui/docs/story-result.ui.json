{
  "$schemaVersion": 1,
  "guid": "ae6f53f5-a489-4023-8930-3663b2196ec1",
  "name": "story-result",
  "title": "Story result",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Story result",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 0,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "sr_backdrop",
        "sr_stage"
      ]
    },
    "sr_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_board",
        "sr_buttons",
        "sr_hint"
      ],
      "style": {
        "pad": 24,
        "w": 520,
        "h": "auto",
        "dir": "column",
        "align": "center",
        "gap": 12,
        "bg": "#f5e9cd",
        "radius": 18,
        "position": "anchored",
        "anchor": [
          0.5,
          0.5
        ],
        "offset": [
          0,
          0
        ]
      },
      "point": "summary-panel"
    },
    "sr_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#b88a40"
      }
    },
    "sr_episode": {
      "type": "label",
      "name": "Label",
      "text": "{episode}",
      "style": {
        "w": "100%",
        "h": 28,
        "fontSize": 18,
        "fitMin": 14,
        "textAlign": "center",
        "color": "#8a6436"
      }
    },
    "sr_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "w": "100%",
        "h": 46,
        "fontSize": 30,
        "fitMin": 22,
        "textAlign": "center",
        "color": "#214e4c"
      },
      "show": "showOutcomeTitle",
      "point": "outcome-title"
    },
    "sr_score_row": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_score_label",
        "sr_score"
      ],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 48,
        "dir": "row",
        "align": "center",
        "justify": "space-between"
      }
    },
    "sr_score_label": {
      "type": "label",
      "name": "Label",
      "text": "SCORE",
      "style": {
        "w": "32%",
        "h": 38,
        "fontSize": 22,
        "fitMin": 18,
        "color": "#354c46"
      }
    },
    "sr_score": {
      "type": "label",
      "name": "Label",
      "text": "{score}",
      "style": {
        "w": "65%",
        "h": 38,
        "fontSize": 30,
        "fitMin": 22,
        "textAlign": "right",
        "color": "#354c46"
      }
    },
    "sr_reward_row": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_reward_label",
        "sr_reward_value"
      ],
      "style": {
        "pad": 6,
        "w": "100%",
        "h": 58,
        "dir": "row",
        "align": "center",
        "justify": "space-between",
        "bg": "#dfebdc",
        "radius": 5
      }
    },
    "sr_reward_label": {
      "type": "label",
      "name": "Label",
      "text": "{rewardLabel}",
      "style": {
        "w": "54%",
        "h": 42,
        "fontSize": 17,
        "fitMin": 14,
        "color": "#245c5b"
      }
    },
    "sr_reward_value": {
      "type": "label",
      "name": "Label",
      "text": "{rewardValue}",
      "style": {
        "w": "44%",
        "h": 42,
        "fontSize": 22,
        "fitMin": 16,
        "textAlign": "right",
        "color": "#245c5b"
      }
    },
    "sr_buttons": {
      "type": "repeat",
      "doc": "overworld-button",
      "property": "buttons",
      "style": {
        "w": "100%",
        "gap": 8
      }
    },
    "sr_hint": {
      "type": "label",
      "name": "Label",
      "text": "{hint}",
      "style": {
        "w": "100%",
        "h": 24,
        "fontSize": 13,
        "fitMin": 13,
        "textAlign": "center",
        "color": "#8a6436"
      }
    },
    "sr_backdrop": {
      "type": "icon",
      "image": "cartoon/ui/results/backdrop",
      "show": "victory",
      "style": {
        "position": "anchored",
        "anchor": [
          0.5,
          0.5
        ],
        "pivot": "centre",
        "w": "100%",
        "h": "100%",
        "fit": "cover",
        "safeArea": "full"
      }
    },
    "sr_stage": {
      "type": "element",
      "children": [
        "sr_headline",
        "sr_hero",
        "sr_caption",
        "sr_panel"
      ],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0.5,
          0.5
        ],
        "pivot": "centre",
        "w": "96%",
        "h": "100%",
        "align": "center",
        "justify": "center"
      }
    },
    "sr_headline": {
      "type": "icon",
      "image": "cartoon/ui/results/bravo",
      "show": "victory",
      "style": {
        "position": "anchored",
        "anchor": [
          0.5,
          0
        ],
        "offset": [
          0,
          8
        ],
        "w": "70%",
        "h": 176,
        "fit": "contain"
      }
    },
    "sr_hero": {
      "type": "icon",
      "image": "cartoon/ui/results/hero",
      "show": "victory",
      "style": {
        "position": "anchored",
        "anchor": [
          0.25,
          0
        ],
        "pivot": [
          0.5,
          0
        ],
        "offset": [
          0,
          218
        ],
        "w": "40%",
        "h": 380,
        "fit": "contain"
      }
    },
    "sr_caption": {
      "type": "label",
      "text": "ONWARD, BRIGADE!",
      "show": "victory",
      "style": {
        "position": "anchored",
        "anchor": [
          0.25,
          0
        ],
        "offset": [
          0,
          606
        ],
        "w": "42%",
        "h": 28,
        "fontSize": 22,
        "fitMin": 16,
        "textAlign": "center",
        "color": "#fff0ca"
      }
    },
    "sr_board": {
      "type": "element",
      "name": "Mission blackboard",
      "children": [
        "sr_rule",
        "sr_episode",
        "sr_title",
        "sr_score_row",
        "sr_reward_row"
      ],
      "style": {
        "w": "100%",
        "pad": 0,
        "dir": "column",
        "gap": 12
      }
    }
  },
  "view": {
    "behaviour": "screen",
    "safe": true
  },
  "transition": {
    "type": "easeOut",
    "ms": 160
  },
  "properties": {
    "episode": {
      "type": "text",
      "default": "LANTERN LANDING"
    },
    "title": {
      "type": "text",
      "default": "MISSION CLEARED"
    },
    "score": {
      "type": "text",
      "default": "0000000"
    },
    "rewardLabel": {
      "type": "text",
      "default": "FIRST-CLEAR REWARD"
    },
    "rewardValue": {
      "type": "text",
      "default": "+10 COINS"
    },
    "hint": {
      "type": "text",
      "default": "ENTER / A TO CONFIRM"
    },
    "buttons": {
      "type": "list",
      "of": "overworld-button",
      "default": []
    },
    "showOutcomeTitle": {
      "type": "yesno",
      "default": true
    },
    "victory": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "sr_panel": {
              "bg": "#00000000",
              "pad": 0,
              "radius": 0
            },
            "sr_board": {
              "image": "cartoon/ui/results/scoreboard",
              "pad": [
                36,
                48,
                36,
                48
              ]
            },
            "sr_rule": {
              "hide": true
            },
            "sr_episode": {
              "color": "#ffd366"
            },
            "sr_title": {
              "color": "#fff1cb"
            },
            "sr_score_label": {
              "color": "#f7edc9"
            },
            "sr_score": {
              "color": "#ffd366"
            },
            "sr_reward_row": {
              "bg": "#00000000",
              "pad": 0,
              "radius": 0
            },
            "sr_reward_label": {
              "color": "#f7edc9"
            },
            "sr_reward_value": {
              "color": "#ffd366"
            },
            "sr_hint": {
              "color": "#fff1cb"
            }
          }
        }
      }
    }
  }
}
