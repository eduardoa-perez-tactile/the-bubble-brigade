{
  "$schemaVersion": 1,
  "guid": "ae6f53f5-a489-4023-8930-3663b2196ec1",
  "name": "story-result",
  "title": "Story result",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Story result",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 20,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "sr_panel"
      ]
    },
    "sr_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_rule",
        "sr_episode",
        "sr_title",
        "sr_score_row",
        "sr_reward_row",
        "sr_buttons",
        "sr_hint"
      ],
      "style": {
        "pad": 24,
        "w": 470,
        "h": "auto",
        "dir": "column",
        "align": "center",
        "gap": 12,
        "bg": "#f0e4c6"
      },
      "point": "summary-panel"
    },
    "sr_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#8c5a35"
      }
    },
    "sr_episode": {
      "type": "label",
      "name": "Label",
      "text": "{episode}",
      "style": {
        "w": "100%",
        "h": 28,
        "fontSize": 18,
        "fitMin": 14,
        "textAlign": "center",
        "color": "#715138"
      }
    },
    "sr_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "w": "100%",
        "h": 52,
        "fontSize": 34,
        "fitMin": 22,
        "textAlign": "center",
        "color": "#382d25"
      },
      "show": "showOutcomeTitle",
      "point": "outcome-title"
    },
    "sr_score_row": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_score_label",
        "sr_score"
      ],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 48,
        "dir": "row",
        "align": "center",
        "justify": "space-between"
      }
    },
    "sr_score_label": {
      "type": "label",
      "name": "Label",
      "text": "SCORE",
      "style": {
        "w": "32%",
        "h": 38,
        "fontSize": 22,
        "fitMin": 18,
        "color": "#5a4936"
      }
    },
    "sr_score": {
      "type": "label",
      "name": "Label",
      "text": "{score}",
      "style": {
        "w": "65%",
        "h": 38,
        "fontSize": 30,
        "fitMin": 22,
        "textAlign": "right",
        "color": "#382d25"
      }
    },
    "sr_reward_row": {
      "type": "element",
      "name": "Element",
      "children": [
        "sr_reward_label",
        "sr_reward_value"
      ],
      "style": {
        "pad": 6,
        "w": "100%",
        "h": 58,
        "dir": "row",
        "align": "center",
        "justify": "space-between",
        "bg": "#e5d3b1"
      }
    },
    "sr_reward_label": {
      "type": "label",
      "name": "Label",
      "text": "{rewardLabel}",
      "style": {
        "w": "54%",
        "h": 42,
        "fontSize": 17,
        "fitMin": 14,
        "color": "#634326"
      }
    },
    "sr_reward_value": {
      "type": "label",
      "name": "Label",
      "text": "{rewardValue}",
      "style": {
        "w": "44%",
        "h": 42,
        "fontSize": 22,
        "fitMin": 16,
        "textAlign": "right",
        "color": "#634326"
      }
    },
    "sr_buttons": {
      "type": "repeat",
      "doc": "overworld-button",
      "property": "buttons",
      "style": {
        "w": "100%",
        "gap": 8
      }
    },
    "sr_hint": {
      "type": "label",
      "name": "Label",
      "text": "{hint}",
      "style": {
        "w": "100%",
        "h": 34,
        "fontSize": 16,
        "fitMin": 13,
        "textAlign": "center",
        "color": "#715138"
      }
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true
  },
  "transition": {
    "type": "easeOut",
    "ms": 160
  },
  "properties": {
    "episode": {
      "type": "text",
      "default": "LANTERN LANDING"
    },
    "title": {
      "type": "text",
      "default": ""
    },
    "score": {
      "type": "text",
      "default": "0000000"
    },
    "rewardLabel": {
      "type": "text",
      "default": "FIRST-CLEAR REWARD"
    },
    "rewardValue": {
      "type": "text",
      "default": "+10 COINS"
    },
    "hint": {
      "type": "text",
      "default": "ENTER / A TO CONFIRM"
    },
    "buttons": {
      "type": "list",
      "of": "overworld-button",
      "default": []
    },
    "showOutcomeTitle": {
      "type": "yesno",
      "default": false
    }
  }
}
