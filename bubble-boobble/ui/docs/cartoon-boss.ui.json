        "color": "#fff3cf",
        "shadowX": 1,
        "shadowY": 2,
        "shadowColor": "#15202b"
      }
    },
    "cb_celebration": {
      "type": "element",
      "name": "Element",
      "children": [
        "cb_victory",
        "cb_ovation"
      ],
      "style": {
        "pad": 0,
        "position": "anchored",
        "anchor": [
          0.5,
          0.43
        ],
        "pivot": "centre",
        "w": "82%",
        "h": 290
      },
      "show": "victory"
