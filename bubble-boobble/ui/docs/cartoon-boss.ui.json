        "h": 240
      }
    },
    "cb_ovation": {
      "type": "label",
      "name": "Label",
      "text": "THE DRAGON IS DOWN.  TAKE A BOW!",
      "style": {
        "position": "anchored",
        "anchor": [
          0.5,
          1
        ],
        "offset": [
          0,
          -4
        ],
        "w": "100%",
        "h": 28,
        "fontSize": 18,
        "fitMin": 12,
        "textAlign": "center",
        "color": "#fff3cf",
        "shadowX": 1,
        "shadowY": 2,
        "shadowColor": "#231e27"
      }
    }
  },
  "view": {
    "behaviour": "screen"
  },
  "properties": {
    "active": {
      "type": "yesno",
      "default": false,
      "poses": {
        "no": {
          "set": {
            "cb_header": {
              "opacity": 0,
              "ty": -48
            }
          }
        },
        "yes": {
          "set": {
            "cb_header": {
              "opacity": 1,
              "ty": 0
            }
          },
          "transition": {
            "type": "easeOut",
            "ms": 650
          }
        }
      }
    },
    "captured": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "cb_fill": {
              "bg": "#75dcca"
            }
          }
        }
      }
    },
    "victory": {
      "type": "yesno",
      "default": false,
      "poses": {
        "no": {
          "set": {
            "cb_celebration": {
              "scale": 0.8,
              "opacity": 0
            }
          }
        },
        "yes": {
          "set": {
            "cb_celebration": {
              "scale": 1,
              "opacity": 1
            },
            "cb_header": {
              "opacity": 0
            }
          },
          "transition": {
            "type": "easeOut",
            "ms": 300
          }
        }
      }
    },
    "health": {
      "type": "number",
      "default": 70,
      "format": "value",
      "drivers": [
        {
          "type": "range",
          "min": 0,
          "maxFrom": "maximum",
          "empty": {
            "set": {
              "cb_fill": {
                "fillAmount": 0
              }
            }
          },
          "full": {
            "set": {
              "cb_fill": {
                "fillAmount": 1
              }
            }
          }
        },
        {
          "type": "smooth",
          "min": 100,
          "max": 300
        }
      ]
    },
    "maximum": {
      "type": "number",
      "default": 70,
      "format": "value"
    },
    "guidance": {
      "type": "text",
      "default": ""
    },
    "healthLabel": {
      "type": "text",
      "default": ""
    }
  }
}
