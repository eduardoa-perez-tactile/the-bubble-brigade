{
  "$schemaVersion": 1,
  "guid": "659e3cb8-522d-4a90-9d12-fdcf499aa023",
  "name": "overworld-encounter",
  "title": "Overworld encounter",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld encounter",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 24,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ow_panel"
      ]
    },
    "ow_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "ow_rule",
        "owe_subtitle",
        "owe_title",
        "owe_description",
        "owe_status",
        "owe_reward",
        "owe_play",
        "owe_back"
      ],
      "style": {
        "pad": 24,
        "dir": "column",
        "align": "center",
        "gap": 10,
        "w": 520,
        "h": "auto",
        "bg": "#eee0bc",
        "radius": 8
      }
    },
    "ow_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#8c5a35"
      }
    },
    "owe_subtitle": {
      "type": "label",
      "name": "Label",
      "text": "{subtitle}",
      "style": {
        "fontSize": 17,
        "fitMin": 14,
        "w": "100%",
        "h": 26,
        "color": "#8c5a35",
        "textAlign": "center"
      }
    },
    "owe_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "fontSize": 34,
        "fitMin": 14,
        "w": "100%",
        "h": 80,
        "color": "#382d25",
        "textAlign": "center"
      }
    },
    "owe_description": {
      "type": "label",
      "name": "Label",
      "text": "{description}",
      "style": {
        "fontSize": 20,
        "fitMin": 14,
        "w": "100%",
        "h": 70,
        "color": "#5a4936",
        "textAlign": "center"
      }
    },
    "owe_status": {
      "type": "label",
      "name": "Label",
      "text": "{status}",
      "style": {
        "fontSize": 18,
        "fitMin": 14,
        "w": "100%",
        "h": 45,
        "color": "#88603b",
        "textAlign": "center"
      }
    },
    "owe_reward": {
      "type": "label",
      "name": "Label",
      "text": "{reward}",
      "style": {
        "fontSize": 19,
        "fitMin": 14,
        "w": "100%",
        "h": 28,
        "color": "#5a4936",
        "textAlign": "center"
      }
    },
    "owe_play": {
      "type": "use",
      "doc": "overworld-button",
      "key": "play",
      "props": {
        "label": {
          "property": "playLabel"
        }
      },
      "style": {
        "w": "100%"
      }
    },
    "owe_back": {
      "type": "use",
      "doc": "overworld-button",
      "key": "back",
      "props": {
        "label": "BACK TO MAP"
      },
      "style": {
        "w": "100%"
      }
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true
  },
  "properties": {
    "title": {
      "type": "text",
      "default": ""
    },
    "subtitle": {
      "type": "text",
      "default": ""
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "status": {
      "type": "text",
      "default": ""
    },
    "reward": {
      "type": "text",
      "default": ""
    },
    "playLabel": {
      "type": "text",
      "default": ""
    },
    "locked": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "owe_play": {
              "hide": true
            }
          }
        }
      }
    }
  }
}
