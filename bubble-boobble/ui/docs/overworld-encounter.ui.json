{
  "$schemaVersion": 1,
  "guid": "659e3cb8-522d-4a90-9d12-fdcf499aa023",
  "name": "overworld-encounter",
  "title": "Overworld encounter",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld encounter",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 24,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ow_panel"
      ]
    },
    "ow_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "ow_rule",
        "owe_subtitle",
        "owe_title",
        "owe_illustration",
        "owe_description",
        "owe_acts",
        "owe_act_breakdown",
        "owe_status",
        "owe_reward",
        "owe_play",
        "owe_back"
      ],
      "style": {
        "pad": 26,
        "dir": "column",
        "align": "center",
        "gap": 8,
        "w": 620,
        "h": "auto",
        "bg": "#f5e9cd",
        "radius": 18
      }
    },
    "ow_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#b88a40"
      }
    },
    "owe_subtitle": {
      "type": "label",
      "name": "Label",
      "text": "{subtitle}",
      "style": {
        "fontSize": 15,
        "fitMin": 13,
        "w": "100%",
        "h": 24,
        "color": "#8a6436",
        "textAlign": "center"
      }
    },
    "owe_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "fontSize": 42,
        "fitMin": 22,
        "w": "100%",
        "h": 58,
        "color": "#214e4c",
        "textAlign": "center"
      }
    },
    "owe_description": {
      "type": "label",
      "name": "Label",
      "text": "{description}",
      "style": {
        "fontSize": 21,
        "fitMin": 16,
        "w": "100%",
        "h": 64,
        "color": "#354c46",
        "textAlign": "center"
      }
    },
    "owe_status": {
      "type": "label",
      "name": "Label",
      "text": "{status}",
      "style": {
        "fontSize": 16,
        "fitMin": 16,
        "w": "100%",
        "h": 34,
        "color": "#245c5b",
        "textAlign": "center",
        "bg": "#dfebdc",
        "radius": 5
      }
    },
    "owe_reward": {
      "type": "label",
      "name": "Label",
      "text": "{reward}",
      "style": {
        "fontSize": 16,
        "fitMin": 16,
        "w": "100%",
        "h": 28,
        "color": "#8a5b27",
        "textAlign": "center"
      }
    },
    "owe_play": {
      "type": "use",
      "doc": "overworld-button",
      "key": "play",
      "props": {
        "label": {
          "property": "playLabel"
        },
        "selected": {
          "property": "playSelected"
        }
      },
      "style": {
        "w": "100%"
      }
    },
    "owe_back": {
      "type": "use",
      "doc": "overworld-button",
      "key": "back",
      "props": {
        "label": "BACK TO MAP",
        "selected": {
          "property": "backSelected"
        }
      },
      "style": {
        "w": "100%"
      }
    },
    "owe_illustration": {
      "type": "icon",
      "image": "adventure/lighthouse",
      "property": "illustration",
      "style": {
        "w": "100%",
        "h": 135,
        "fit": "cover"
      }
    },
    "owe_acts": {
      "type": "label",
      "name": "Label",
      "text": "{actSummary}",
      "style": {
        "fontSize": 19,
        "fitMin": 16,
        "w": "100%",
        "h": 26,
        "color": "#245c5b",
        "textAlign": "center",
        "weight": 700
      }
    },
    "owe_act_breakdown": {
      "type": "label",
      "name": "Label",
      "text": "{actBreakdown}",
      "style": {
        "fontSize": 16,
        "fitMin": 13,
        "w": "100%",
        "h": 24,
        "color": "#8a6436",
        "textAlign": "center"
      }
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true,
    "enter": {
      "set": {
        "ow_panel": {
          "opacity": 0,
          "ty": 20,
          "scale": 0.97
        }
      }
    },
    "exit": {
      "set": {
        "ow_panel": {
          "opacity": 0,
          "ty": 10,
          "scale": 0.985
        }
      },
      "transition": {
        "type": "easeOut",
        "ms": 140
      }
    }
  },
  "properties": {
    "title": {
      "type": "text",
      "default": ""
    },
    "subtitle": {
      "type": "text",
      "default": ""
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "status": {
      "type": "text",
      "default": ""
    },
    "reward": {
      "type": "text",
      "default": ""
    },
    "playLabel": {
      "type": "text",
      "default": ""
    },
    "locked": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "owe_play": {
              "hide": true
            }
          }
        }
      }
    },
    "illustration": {
      "type": "image",
      "default": "adventure/lighthouse"
    },
    "playSelected": {
      "type": "yesno",
      "default": true
    },
    "backSelected": {
      "type": "yesno",
      "default": false
    },
    "actSummary": {
      "type": "text",
      "default": ""
    },
    "actBreakdown": {
      "type": "text",
      "default": ""
    }
  },
  "transition": {
    "type": "easeOut",
    "ms": 220
  }
}
