{
  "$schemaVersion": 1,
  "guid": "659e3cb8-522d-4a90-9d12-fdcf499aa023",
  "name": "overworld-encounter",
  "title": "Overworld encounter",
  "kind": "view",
  "root": "root",
  "nodes": {
    "root": {
      "type": "element",
      "name": "Overworld encounter",
      "style": {
        "w": "100%",
        "h": "100%",
        "pad": 24,
        "align": "center",
        "justify": "center"
      },
      "children": [
        "ow_panel"
      ]
    },
    "ow_panel": {
      "type": "element",
      "name": "Element",
      "children": [
        "ow_rule",
        "owe_subtitle",
        "owe_title",
        "owe_illustration",
        "owe_description",
        "owe_status",
        "owe_reward",
        "owe_play",
        "owe_back"
      ],
      "style": {
        "pad": 22,
        "dir": "column",
        "align": "center",
        "gap": 8,
        "w": 650,
        "h": "auto",
        "bg": "#f0e4c6",
        "radius": 0
      }
    },
    "ow_rule": {
      "type": "element",
      "name": "Element",
      "children": [],
      "style": {
        "pad": 0,
        "w": "100%",
        "h": 3,
        "bg": "#8c5a35"
      }
    },
    "owe_subtitle": {
      "type": "label",
      "name": "Label",
      "text": "{subtitle}",
      "style": {
        "fontSize": 17,
        "fitMin": 16,
        "w": "100%",
        "h": 24,
        "color": "#8a4c37",
        "textAlign": "center"
      }
    },
    "owe_title": {
      "type": "label",
      "name": "Label",
      "text": "{title}",
      "style": {
        "fontSize": 44,
        "fitMin": 22,
        "w": "100%",
        "h": 64,
        "color": "#382d25",
        "textAlign": "center"
      }
    },
    "owe_description": {
      "type": "label",
      "name": "Label",
      "text": "{description}",
      "style": {
        "fontSize": 21,
        "fitMin": 16,
        "w": "100%",
        "h": 66,
        "color": "#5a4936",
        "textAlign": "center"
      }
    },
    "owe_status": {
      "type": "label",
      "name": "Label",
      "text": "{status}",
      "style": {
        "fontSize": 18,
        "fitMin": 16,
        "w": "100%",
        "h": 38,
        "color": "#88603b",
        "textAlign": "center"
      }
    },
    "owe_reward": {
      "type": "label",
      "name": "Label",
      "text": "{reward}",
      "style": {
        "fontSize": 17,
        "fitMin": 16,
        "w": "100%",
        "h": 26,
        "color": "#5a4936",
        "textAlign": "center"
      }
    },
    "owe_play": {
      "type": "use",
      "doc": "overworld-button",
      "key": "play",
      "props": {
        "label": {
          "property": "playLabel"
        },
        "selected": {
          "property": "playSelected"
        }
      },
      "style": {
        "w": "100%"
      }
    },
    "owe_back": {
      "type": "use",
      "doc": "overworld-button",
      "key": "back",
      "props": {
        "label": "BACK TO MAP",
        "selected": {
          "property": "backSelected"
        }
      },
      "style": {
        "w": "100%"
      }
    },
    "owe_illustration": {
      "type": "icon",
      "image": "adventure/lighthouse",
      "property": "illustration",
      "style": {
        "w": "100%",
        "h": 155,
        "fit": "cover"
      }
    }
  },
  "view": {
    "behaviour": "dialog",
    "dims": true
  },
  "properties": {
    "title": {
      "type": "text",
      "default": ""
    },
    "subtitle": {
      "type": "text",
      "default": ""
    },
    "description": {
      "type": "text",
      "default": ""
    },
    "status": {
      "type": "text",
      "default": ""
    },
    "reward": {
      "type": "text",
      "default": ""
    },
    "playLabel": {
      "type": "text",
      "default": ""
    },
    "locked": {
      "type": "yesno",
      "default": false,
      "poses": {
        "yes": {
          "set": {
            "owe_play": {
              "hide": true
            }
          }
        }
      }
    },
    "illustration": {
      "type": "image",
      "default": "adventure/lighthouse"
    },
    "playSelected": {
      "type": "yesno",
      "default": true
    },
    "backSelected": {
      "type": "yesno",
      "default": false
    }
  },
  "transition": {
    "type": "easeOut",
    "ms": 160
  }
}
