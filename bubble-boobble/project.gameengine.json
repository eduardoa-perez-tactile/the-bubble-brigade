      },
      "overworld-district-5": {
        "include": [
          "assets/overworld-original/district-5/**",
          "assets/overworld-living/district-5/**",
          "assets/overworld-living/common/**"
        ]
      },
      "overworld-shared": {
        "include": [
          "assets/overworld-shared/**"
        ]
      },
      "shop-presentation": {
        "include": ["assets/cartoon/shop/scene-*.png", "assets/cartoon/shop/owner-*", "assets/cartoon/shop/action-paper.png", "assets/cartoon/shop/pointing-hand.png", "assets/cartoon/shop/price-tag.png", "assets/cartoon/shop/gold-coin.png", "assets/cartoon/shop/owned-marker.png", "assets/cartoon/shop/active-marker.png"]
      },
      "adventure-lighthouse": {
        "include": [
