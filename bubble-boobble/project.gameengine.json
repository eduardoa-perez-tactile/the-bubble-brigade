  "bundles": [
    {
      "name": "base",
      "include": [
        "**"
      ],
      "delivery": "in-app"
    }
  ],
  "targets": [
    "ios",
    "android"
  ],
  "platforms": [
    "desktop",
    "web"
  ],
  "startScene": "scenes/cartoon.scene.json",
  "audio": {
    "banks": [
      "reference/audio/sfx.bank",
      "audio/juice.bank",
      "audio/brigade/sfx/core.bank"
    ],
    "maxVoices": 24,
    "normalize": false
