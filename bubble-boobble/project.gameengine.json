{
  "$schemaVersion": 2,
  "name": "The Bubble Brigade",
  "bundleId": {
    "ios": "com.example.bubbleboobble",
    "android": "com.example.bubbleboobble",
    "web": "com.tactile.prototypes.bubblemadness"
  },
  "version": "0.1.0",
  "sim": {
    "dt": 0.016666667,
    "maxStepsPerFrame": 5,
    "physicsThreads": 1,
    "hashInDev": true,
    "seed": 1
  },
  "js": {
    "entry": "src/main.ts",
    "target": "es2020"
  },
  "render": {
    "defaultTier": "auto",
    "tiers": {
      "mobile": {
        "msaa": 1,
        "hdr": false
      },
      "compat": {
        "msaa": 1,
        "hdr": false
      },
      "desktop": {
        "features": {
          "spotShadows": true
        }
      }
    },
    "clearColor": [
      0,
      0,
      0,
      1
    ],
    "sortingLayers": [
      "Default"
    ],
    "pixelsPerUnit": 100
  },
  "ui": {
    "referenceResolution": [
      768,
      720
    ],
    "orientation": "landscape"
  },
  "assets": {
    "groups": {
      "film-presentation": {
        "include": ["assets/cartoon/film/**"]
      },
      "courtyard-gameplay": {
        "include": [
          "assets/cartoon/frames/**",
          "assets/cartoon/reconstruction/environment/**",
          "assets/pixel-renderer/static-quad.gltf",
          "assets/materials/courtyard-motion.mat.json",
          "assets/materials/courtyard-motion.material.ts"
        ]
      },
      "overworld-district-1": {
        "include": [
          "assets/overworld-original/district-1/**",
          "assets/overworld-living/district-1/**",
          "assets/overworld-living/common/**"
        ]
      },
      "overworld-district-2": {
        "include": [
          "assets/overworld-original/district-2/**",
          "assets/overworld-living/district-2/**",
          "assets/overworld-living/common/**"
        ]
      },
      "overworld-district-3": {
        "include": [
          "assets/overworld-original/district-3/**",
          "assets/overworld-living/district-3/**",
          "assets/overworld-living/common/**"
